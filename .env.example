# Apex Editor — environment
#
# Copy to .env.local and fill in. NEVER commit the filled copy.
#
# ---------------------------------------------------------------------------
# Everything prefixed VITE_ is compiled into the JavaScript bundle and is
# readable by anyone who opens the site. That is fine for public identifiers.
# It is never fine for a secret.
#
#   PUBLIC and safe here:  the Firebase web config (the API key identifies a
#                          project, it does not authorise anything; Firestore
#                          rules and Auth are the boundary), Worker URLs.
#
#   NEVER here:            Backblaze B2 key id or application key,
#                          any AI provider API key,
#                          any Firebase service account JSON.
#                          Those live in the Worker as secrets.
#
# There is no VITE_OWNER_UID any more. It was a convenience check that looked
# like security; ownership is enforced by firestore.rules and by the Worker's
# Firebase ID token check.
# ---------------------------------------------------------------------------

# Firebase — from Project settings -> Your apps -> Web app.
# Leave all four blank to run the app in local mode: import and export work,
# saving does not, and the header says so plainly.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Apex AI Router Worker — captions and the timeline copilot (milestone 3).
# Your route, not a vendor's: it checks your Firebase ID token before spending
# free allowance.
VITE_APEX_AI_ROUTER_URL=

# Apex Drive / AI Router Worker — presigned B2 URLs for the media bin.
# The presign route forces every key under u/<uid>/ and verifies the ID token.
VITE_APEX_DRIVE_URL=
