# Apex Editor — environment
#
# Copy to .env.local and fill in. NEVER commit the filled copy.
#
# ---------------------------------------------------------------------------
# Everything prefixed VITE_ is compiled into the JavaScript bundle and is
# readable by anyone who opens the site. That is fine for public identifiers.
# It is never fine for a secret.
#
#   PUBLIC and safe here:  Firebase API key (it identifies a project, it does not authorise),
#                          Supabase URL, Supabase anon key (protected by RLS),
#                          Firebase project id, the owner UID, Worker URLs.
#
#   NEVER here:            Backblaze B2 key id or application key,
#                          Supabase service_role key,
#                          any AI provider API key,
#                          any Firebase service account JSON.
#                          Those live in the Worker as secrets:
#                            npx wrangler secret put DRIVE_B2_APP_KEY
# ---------------------------------------------------------------------------

# Firebase Auth (the sign-in gate). From Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The single account allowed to open the editor. Convenience only — the real
# boundary is the RLS policy in supabase/migrations and the Worker's token check.
VITE_OWNER_UID=

# Supabase (project timeline JSON). The anon key is public by design; RLS decides
# what it can reach. Leave both blank if you decide to store timelines in Firestore.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Apex AI Router Worker — captions and the timeline copilot.
# Your route, not a vendor's: it checks your Firebase token before spending allowance.
VITE_APEX_AI_ROUTER_URL=

# Apex Drive Worker — presigned B2 URLs for the media bin.
VITE_APEX_DRIVE_URL=
