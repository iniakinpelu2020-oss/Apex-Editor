rules_version = '2';

// Apex Editor — Cloud Firestore security rules.
//
// One owner, one document per project, and no path that trusts the client.
//
// The shape is deliberately narrow:
//   * a read or write needs a signed-in user, and that user must own the row
//   * a create must carry the caller's own uid as userId
//   * userId can never be changed afterwards, so a document cannot be handed to
//     another account by editing it
//
// Deploy with:  firebase deploy --only firestore:rules
// Test in the Rules Playground before you trust it, with the real uid.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function claimsOwnership() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Timeline JSON only: a document has to stay small enough to be one write.
    function looksLikeProject() {
      let d = request.resource.data;
      return d.id is string
        && d.title is string
        && d.title.size() <= 200
        && d.aspect in ['16:9', '9:16', '1:1']
        && d.clips is list
        && d.clips.size() <= 500
        && d.version == 1;
    }

    match /projects/{projectId} {
      allow read: if ownsExisting();

      allow create: if claimsOwnership()
        && looksLikeProject()
        && projectId == request.resource.data.id;

      // Updates must keep the same owner. Without this, an owner could rewrite
      // userId and leave a document another account can never touch or clean up.
      allow update: if ownsExisting()
        && claimsOwnership()
        && looksLikeProject()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if ownsExisting();
    }

    // Everything else is closed. New collections are not readable by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
